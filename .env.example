# Clerk — autenticação da aplicação interna
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# PostgreSQL — use Neon Postgres Free durante testes e produção inicial
DATABASE_URL=postgresql://usuario:senha@host/neondb?sslmode=require

# Azure Blob Storage — container temporário para upload de arquivos
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=uploads-temp


# Google Places — obrigatório para busca de concorrentes com avaliações/estrelas
# Ative a Places API (New) no Google Cloud e restrinja a chave por API.
# Pode gerar custo se ultrapassar o limite gratuito/cotas configuradas.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_MAX_SEARCHES_PER_ANALYSIS=24

# APIs gratuitas / planos gratuitos
# LocationIQ: plano gratuito. Usado para geocodificar endereços/CEPs com cache obrigatório.
LOCATIONIQ_API_KEY=
# OpenRouteService: plano gratuito. Usado para distância de carro quando disponível.
ORS_API_KEY=

# Consulta CNPJ — BrasilAPI + ReceitaWS + OpenCNPJ, todas sem chave no fluxo implementado
# Nenhuma variável de ambiente necessária para essas APIs.

# OpenAI — opcional. Pode gerar custo. Se vazio, o app usa fallback local.
OPENAI_API_KEY=

# Configurações internas
ANALYSIS_RATE_LIMIT_PER_HOUR=10
SHARED_LINK_TTL_DAYS=7
NEXT_PUBLIC_APP_NAME=Inteligência My Robot
